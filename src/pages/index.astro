---
import Layout from '../layouts/Layout.astro';
---

<Layout title="GeoMapper — Upload CSV">
  <!-- Animated background orbs -->
  <div class="bg-orb bg-orb-1"></div>
  <div class="bg-orb bg-orb-2"></div>

  <div class="page-wrap">
    <!-- Header -->
    <header class="header anim-fade-up">
      <div class="logo">
        <span class="logo-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
            <circle cx="12" cy="9" r="2.5"/>
          </svg>
        </span>
        <span class="logo-text">GeoMapper</span>
      </div>
      <div class="header-badge">Premium</div>
    </header>

    <!-- Hero -->
    <main class="main">
      <div class="hero anim-fade-up anim-fade-up-1">
        <div class="hero-eyebrow">CSV → Interactive Map</div>
        <h1 class="hero-title">
          Visualize your<br />
          <span class="gradient-text">location data</span><br />
          instantly
        </h1>
        <p class="hero-subtitle">
          Upload any CSV with latitude and longitude columns.<br />
          We'll plot everything on a beautiful interactive map.
        </p>
      </div>

      <!-- Upload card -->
      <div class="upload-card glass anim-fade-up anim-fade-up-2">
        <div
          id="upload-zone"
          class="upload-zone"
          role="button"
          tabindex="0"
          aria-label="Upload CSV file"
        >
          <!-- Idle state -->
          <div id="state-idle" class="upload-state">
            <div class="upload-icon-wrap">
              <div class="upload-icon-float">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14,2 14,8 20,8"/>
                  <line x1="12" y1="18" x2="12" y2="12"/>
                  <polyline points="9,15 12,12 15,15"/>
                </svg>
              </div>
            </div>
            <h2 class="upload-title">Drop your CSV here</h2>
            <p class="upload-sub">or click to browse files</p>
            <button id="browse-btn" class="btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17,8 12,3 7,8"/>
                <line x1="12" y1="3" x2="12" y2="15"/>
              </svg>
              Browse Files
            </button>
            <p class="upload-hint">Supports .csv — Name, lat, lng columns required</p>
            <a id="sample-dl" class="sample-link" download="sample.csv">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7,10 12,15 17,10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              Download sample CSV
            </a>
          </div>

          <!-- Loading state -->
          <div id="state-loading" class="upload-state hidden">
            <div class="spinner"></div>
            <h2 class="upload-title">Parsing your data…</h2>
            <p class="upload-sub">Extracting locations from CSV</p>
          </div>

          <!-- Error state -->
          <div id="state-error" class="upload-state hidden">
            <div class="error-icon">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
            </div>
            <h2 class="upload-title">Upload failed</h2>
            <p id="error-message" class="upload-sub error-text"></p>
            <button id="retry-btn" class="btn-ghost">Try again</button>
          </div>

          <!-- Success state -->
          <div id="state-success" class="upload-state hidden">
            <div class="success-icon">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="8,12 11,15 16,9"/>
              </svg>
            </div>
            <h2 class="upload-title">Locations found!</h2>
            <p id="success-message" class="upload-sub success-text"></p>
            <p class="upload-hint">Opening map…</p>
          </div>
        </div>

        <!-- Mobile pickers match on MIME type, and many report CSVs as text/comma-separated-values,
             application/vnd.ms-excel or text/plain — listing only ".csv" greys them out on phones/tablets. -->
        <input
          type="file"
          id="file-input"
          accept=".csv,text/csv,text/comma-separated-values,application/csv,application/vnd.ms-excel,text/plain"
          hidden
        />
      </div>

      <!-- Steps -->
      <div class="steps-section anim-fade-up anim-fade-up-3">
        <p class="steps-label">How it works</p>
        <div class="steps">
          <div class="step">
            <div class="step-num">1</div>
            <div>
              <strong>Upload CSV</strong>
              <p>Drop or select your CSV file with location data</p>
            </div>
          </div>
          <div class="step-arrow">→</div>
          <div class="step">
            <div class="step-num">2</div>
            <div>
              <strong>Auto Parse</strong>
              <p>We extract Name, lat &amp; lng columns instantly</p>
            </div>
          </div>
          <div class="step-arrow">→</div>
          <div class="step">
            <div class="step-num">3</div>
            <div>
              <strong>Explore Map</strong>
              <p>Click markers to inspect each location in detail</p>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>

<script>
  import Papa from 'papaparse';

  const zone      = document.getElementById('upload-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const browseBtn = document.getElementById('browse-btn')!;
  const retryBtn  = document.getElementById('retry-btn')!;
  const sampleDl  = document.getElementById('sample-dl') as HTMLAnchorElement;

  const stateIdle    = document.getElementById('state-idle')!;
  const stateLoading = document.getElementById('state-loading')!;
  const stateError   = document.getElementById('state-error')!;
  const stateSuccess = document.getElementById('state-success')!;
  const errorMsg     = document.getElementById('error-message')!;
  const successMsg   = document.getElementById('success-message')!;

  // Sample CSV download
  const sampleCSV = `Name,lat,lng\nTokyo,35.6762,139.6503\nNew York,40.7128,-74.0060\nLondon,51.5074,-0.1278\nParis,48.8566,2.3522\nSydney,-33.8688,151.2093\nDubai,25.2048,55.2708\nSingapore,1.3521,103.8198\nToronto,43.6532,-79.3832`;
  sampleDl.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(sampleCSV);

  function show(state: 'idle' | 'loading' | 'error' | 'success') {
    stateIdle.classList.toggle('hidden', state !== 'idle');
    stateLoading.classList.toggle('hidden', state !== 'loading');
    stateError.classList.toggle('hidden', state !== 'error');
    stateSuccess.classList.toggle('hidden', state !== 'success');
  }

  function showError(msg: string) {
    errorMsg.textContent = msg;
    show('error');
    zone.classList.remove('drag-over');
  }

  function processFile(file: File) {
    const csvTypes = ['text/csv', 'text/comma-separated-values', 'application/csv', 'application/vnd.ms-excel', 'text/plain'];
    // Some mobile pickers (e.g. Drive/Files providers) drop the extension, so accept a CSV MIME type too
    if (!file.name.toLowerCase().endsWith('.csv') && !csvTypes.includes(file.type)) {
      showError('Please upload a .csv file.');
      return;
    }
    show('loading');

    Papa.parse(file, {
      header: true,
      skipEmptyLines: true,
      complete: ({ data }: { data: Record<string, string>[] }) => {
        const locations = data
          .map((row) => {
            // Trim all keys to handle space-padded column headers
            const r: Record<string, string> = {};
            Object.keys(row).forEach((k) => { r[k.trim()] = row[k]; });
            return {
              name: (r['Name'] ?? '').trim(),
              lat:  parseFloat(r['lat']  ?? ''),
              lng:  parseFloat(r['lng']  ?? ''),
            };
          })
          .filter((loc) => loc.name && !isNaN(loc.lat) && !isNaN(loc.lng));

        if (locations.length === 0) {
          showError('No valid locations found. Ensure the CSV has Name, lat, lng columns.');
          return;
        }

        sessionStorage.setItem('mapData', JSON.stringify(locations));
        successMsg.textContent = `Found ${locations.length.toLocaleString()} location${locations.length === 1 ? '' : 's'}`;
        show('success');
        setTimeout(() => { window.location.href = '/map'; }, 900);
      },
      error: (err: Error) => {
        showError('Failed to parse CSV: ' + err.message);
      },
    });
  }

  // Drag-and-drop
  zone.addEventListener('dragover', (e) => {
    e.preventDefault();
    zone.classList.add('drag-over');
  });
  zone.addEventListener('dragleave', (e) => {
    if (!zone.contains(e.relatedTarget as Node)) {
      zone.classList.remove('drag-over');
    }
  });
  zone.addEventListener('drop', (e) => {
    e.preventDefault();
    zone.classList.remove('drag-over');
    const file = e.dataTransfer?.files[0];
    if (file) processFile(file);
  });

  // Click-to-browse
  browseBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    fileInput.click();
  });
  zone.addEventListener('click', () => {
    if (!stateIdle.classList.contains('hidden')) fileInput.click();
  });
  zone.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') fileInput.click();
  });
  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (file) processFile(file);
  });

  // Retry
  retryBtn.addEventListener('click', () => {
    show('idle');
    fileInput.value = '';
  });
</script>

<style>
  /* ── Page chrome ─────────────────────────────── */
  .bg-orb {
    position: fixed;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }
  .bg-orb-1 {
    width: 500px; height: 500px;
    top: -100px; left: -120px;
    background: radial-gradient(circle, rgba(139,92,246,0.18) 0%, transparent 70%);
  }
  .bg-orb-2 {
    width: 400px; height: 400px;
    bottom: -80px; right: -100px;
    background: radial-gradient(circle, rgba(6,182,212,0.14) 0%, transparent 70%);
  }

  .page-wrap {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 32px 20px 60px;
    background: linear-gradient(135deg, #060714 0%, #0d1b2a 100%);
  }

  /* ── Header ──────────────────────────────────── */
  .header {
    width: 100%;
    max-width: 680px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 56px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .logo-icon {
    width: 40px; height: 40px;
    border-radius: 10px;
    background: var(--gradient);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    flex-shrink: 0;
  }
  .logo-text {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }
  .header-badge {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-light);
    background: rgba(139,92,246,0.15);
    border: 1px solid rgba(139,92,246,0.3);
    padding: 4px 10px;
    border-radius: 20px;
  }

  /* ── Hero ────────────────────────────────────── */
  .main {
    width: 100%;
    max-width: 680px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  .hero { text-align: center; }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cyan);
    background: rgba(6,182,212,0.1);
    border: 1px solid rgba(6,182,212,0.25);
    padding: 5px 14px;
    border-radius: 20px;
    margin-bottom: 20px;
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--text-primary);
    margin-bottom: 16px;
  }

  .hero-subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* ── Upload card ─────────────────────────────── */
  .upload-card {
    width: 100%;
    border-radius: var(--radius-xl);
    padding: 6px;
    box-shadow: var(--shadow-card), var(--shadow-glow-purple);
  }

  .upload-zone {
    border: 2px dashed rgba(139, 92, 246, 0.35);
    border-radius: calc(var(--radius-xl) - 4px);
    padding: 52px 40px;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.25s ease, background 0.25s ease;
    outline: none;
  }
  .upload-zone:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .upload-zone:hover,
  .upload-zone.drag-over {
    border-color: var(--accent);
    background: rgba(139, 92, 246, 0.06);
  }
  .upload-zone.drag-over {
    background: rgba(139, 92, 246, 0.1);
    box-shadow: inset 0 0 40px rgba(139, 92, 246, 0.1);
  }

  /* States */
  .upload-state { display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .hidden { display: none !important; }

  .upload-icon-wrap {
    width: 80px; height: 80px;
    border-radius: 20px;
    background: rgba(139, 92, 246, 0.12);
    border: 1px solid rgba(139, 92, 246, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
    color: var(--accent-light);
  }
  .upload-icon-float {
    animation: float 3s ease-in-out infinite;
  }

  .upload-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .upload-sub {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }
  .upload-hint {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 4px;
  }
  .error-text   { color: #f87171; }
  .success-text { color: #4ade80; }

  .success-icon {
    color: #4ade80;
    width: 64px; height: 64px;
    background: rgba(74,222,128,0.1);
    border: 1px solid rgba(74,222,128,0.25);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 4px;
    animation: successPop 0.4s cubic-bezier(0.2, 0, 0.1, 1.4) both;
  }

  @keyframes successPop {
    from { transform: scale(0.7); opacity: 0; }
    to   { transform: scale(1);   opacity: 1; }
  }

  .sample-link {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.75rem; font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    margin-top: 2px;
    padding: 4px 8px;
    border-radius: 6px;
    transition: color 0.15s, background 0.15s;
  }
  .sample-link:hover {
    color: var(--text-secondary);
    background: rgba(255,255,255,0.05);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    background: var(--gradient);
    color: white;
    font-size: 0.9rem;
    font-weight: 600;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.15s;
    margin: 8px 0;
  }
  .btn-primary:hover { opacity: 0.88; transform: translateY(-1px); }
  .btn-primary:active { transform: translateY(0); }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 22px;
    background: transparent;
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 500;
    border: 1px solid var(--glass-border);
    border-radius: 10px;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .btn-ghost:hover {
    color: var(--text-primary);
    border-color: rgba(255,255,255,0.2);
    background: rgba(255,255,255,0.04);
  }

  .spinner {
    width: 44px; height: 44px;
    border: 3px solid rgba(139,92,246,0.2);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-bottom: 8px;
  }

  .error-icon {
    color: #f87171;
    width: 64px; height: 64px;
    background: rgba(248,113,113,0.1);
    border: 1px solid rgba(248,113,113,0.25);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 4px;
  }

  /* ── Steps ───────────────────────────────────── */
  .steps-section { text-align: center; width: 100%; }

  .steps-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 24px;
  }

  .steps {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .step {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    max-width: 180px;
    text-align: left;
  }

  .step-num {
    flex-shrink: 0;
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--gradient);
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }

  .step strong {
    display: block;
    font-size: 0.9rem;
    color: var(--text-primary);
    margin-bottom: 2px;
  }
  .step p {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .step-arrow {
    color: var(--text-muted);
    font-size: 1.1rem;
    padding-top: 6px;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .upload-zone { padding: 40px 24px; }
    .step-arrow { display: none; }
    .step { max-width: none; }
    .steps { flex-direction: column; align-items: flex-start; padding: 0 8px; }
  }
</style>

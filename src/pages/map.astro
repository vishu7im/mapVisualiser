---
import Layout from "../layouts/Layout.astro";
import "leaflet/dist/leaflet.css";
import "leaflet.markercluster/dist/MarkerCluster.css";
import "leaflet.markercluster/dist/MarkerCluster.Default.css";
---

<Layout title="GeoMapper — Map View">
  <!-- Navbar -->
  <nav class="navbar glass">
    <a href="/" class="nav-logo">
      <span class="nav-logo-icon">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
        >
          <path
            d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"
          ></path>
          <circle cx="12" cy="9" r="2.5"></circle>
        </svg>
      </span>
      GeoMapper
    </a>

    <div id="loc-badge" class="nav-badge hidden">
      <span class="badge-dot"></span>
      <span id="loc-num">0</span>&nbsp;locations
    </div>

    <!-- Search bar -->
    <div class="nav-search-wrap">
      <div class="nav-search-row">
        <svg
          class="search-icon"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
        >
          <circle cx="11" cy="11" r="8"></circle><line
            x1="21"
            y1="21"
            x2="16.65"
            y2="16.65"></line>
        </svg>
        <input
          id="search-input"
          type="text"
          placeholder="Search locations…"
          autocomplete="off"
          spellcheck="false"
        />
        <button id="search-clear" class="clear-btn hidden" aria-label="Clear">
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line><line
              x1="6"
              y1="6"
              x2="18"
              y2="18"></line>
          </svg>
        </button>
      </div>
      <div id="search-dropdown" class="search-dropdown hidden">
        <div id="search-results"></div>
      </div>
    </div>

    <a href="/" class="btn-new">
      <svg
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
      >
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="17,8 12,3 7,8"></polyline>
        <line x1="12" y1="3" x2="12" y2="15"></line>
      </svg>
      New Upload
    </a>
  </nav>

  <!-- Main layout: map + sidebar -->
  <div class="workspace">
    <!-- Map -->
    <div class="map-wrap">
      <div id="map"></div>

      <!-- Map Controls Panel -->
      <div class="map-controls glass">
        <!-- Fit all -->
        <button id="btn-fit-all" class="ctrl-btn" title="Fit all markers">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
          >
            <path
              d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"
            ></path>
          </svg>
        </button>
        <!-- Route toggle -->
        <button
          id="btn-route"
          class="ctrl-btn active"
          title="Toggle route line"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
          >
            <path d="M3 17c3-3 6-3 9 0s6 3 9 0"></path><path
              d="M3 7c3-3 6-3 9 0s6 3 9 0"></path>
          </svg>
        </button>
        <!-- Heatmap toggle -->
        <button id="btn-heat" class="ctrl-btn" title="Toggle heatmap">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
          >
            <circle cx="12" cy="12" r="3"></circle><circle
              cx="12"
              cy="12"
              r="7"
              opacity="0.4"></circle><circle
              cx="12"
              cy="12"
              r="11"
              opacity="0.15"></circle>
          </svg>
        </button>
        <!-- Divider -->
        <div class="ctrl-divider"></div>
        <!-- Tile switcher -->
        <div class="tile-group">
          <button class="tile-btn" data-tile="dark">Dark</button>
          <button class="tile-btn" data-tile="light">Light</button>
          <button class="tile-btn active" data-tile="streets">OSM</button>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <aside class="sidebar glass">
      <!-- Sidebar tabs -->
      <div class="sb-tabs">
        <button id="tab-detail" class="sb-tab active">Detail</button>
        <button id="tab-overview" class="sb-tab">Overview</button>
      </div>

      <!-- Welcome state -->
      <div id="state-welcome" class="sb-state">
        <div class="welcome-icon">
          <svg
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <polygon points="3,11 22,2 13,21 11,13"></polygon>
          </svg>
        </div>
        <p class="welcome-title">Select a location</p>
        <p class="welcome-sub">
          Click any marker on the map or search above to view details.
        </p>
      </div>

      <!-- Detail state -->
      <div id="state-detail" class="sb-state hidden">
        <!-- Navigation bar -->
        <div class="detail-nav">
          <button id="btn-prev" class="nav-btn" title="Previous">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <polyline points="15,18 9,12 15,6"></polyline>
            </svg>
          </button>
          <span id="detail-pos" class="detail-pos">1 / 1</span>
          <button id="btn-next" class="nav-btn" title="Next">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <polyline points="9,18 15,12 9,6"></polyline>
            </svg>
          </button>
          <button id="panel-close" class="close-btn" title="Close">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <line x1="18" y1="6" x2="6" y2="18"></line><line
                x1="6"
                y1="6"
                x2="18"
                y2="18"></line>
            </svg>
          </button>
        </div>

        <!-- Location header -->
        <div class="detail-header">
          <div id="ref-badge" class="ref-badge hidden">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
              <polygon
                points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"
              ></polygon>
            </svg>
            Reference Point
          </div>
          <h2 id="panel-name" class="detail-name">—</h2>
        </div>

        <!-- Coords -->
        <div class="detail-section">
          <p class="section-label">Coordinates</p>
          <div class="coord-row">
            <div class="coord-chip">
              <span class="coord-key">LAT</span>
              <span id="panel-lat" class="coord-val">—</span>
              <button id="copy-lat" class="copy-btn" title="Copy latitude">
                <svg
                  class="copy-icon"
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                >
                  <rect x="9" y="9" width="13" height="13" rx="2"></rect><path
                    d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                  ></path>
                </svg>
                <svg
                  class="copy-check hidden"
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#4ade80"
                  stroke-width="2.5"
                >
                  <polyline points="20,6 9,17 4,12"></polyline>
                </svg>
              </button>
            </div>
            <div class="coord-chip">
              <span class="coord-key">LNG</span>
              <span id="panel-lng" class="coord-val">—</span>
              <button id="copy-lng" class="copy-btn" title="Copy longitude">
                <svg
                  class="copy-icon"
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                >
                  <rect x="9" y="9" width="13" height="13" rx="2"></rect><path
                    d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                  ></path>
                </svg>
                <svg
                  class="copy-check hidden"
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#4ade80"
                  stroke-width="2.5"
                >
                  <polyline points="20,6 9,17 4,12"></polyline>
                </svg>
              </button>
            </div>
          </div>
        </div>

        <!-- Distance -->
        <div id="dist-section" class="detail-section hidden">
          <p class="section-label">Distance from reference</p>
          <div class="dist-pill">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <line x1="2" y1="12" x2="22" y2="12"></line><polyline
                points="15,5 22,12 15,19"></polyline>
            </svg>
            <span id="panel-dist">—</span>
            <span class="dist-unit">km</span>
          </div>
        </div>

        <!-- Nearby -->
        <div id="nearby-section" class="detail-section hidden">
          <div class="nearby-header">
            <p class="section-label" id="nearby-label">Nearby</p>
            <span id="nearby-count" class="nearby-count-badge">0</span>
          </div>
          <div id="nearby-list"></div>
        </div>

        <!-- Maps link -->
        <div class="detail-section">
          <a
            id="panel-maps-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="maps-btn"
          >
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <polygon points="3,11 22,2 13,21 11,13"></polygon>
            </svg>
            Open in Google Maps
          </a>
        </div>
      </div><!-- /state-detail -->

      <!-- Overview state -->
      <div id="state-overview" class="sb-state hidden">
        <p class="section-label" style="padding: 0 0 12px;">Dataset Overview</p>

        <div class="stats-grid">
          <div class="stat-card">
            <div id="stat-count" class="stat-val">—</div>
            <div class="stat-label">Locations</div>
          </div>
          <div class="stat-card">
            <div id="stat-route" class="stat-val gradient-text">—</div>
            <div class="stat-label">Route km</div>
          </div>
          <div class="stat-card stat-full">
            <div
              id="stat-coverage"
              class="stat-val"
              style="color: var(--cyan);"
            >
              —
            </div>
            <div class="stat-label">Coverage diagonal (km)</div>
          </div>
        </div>

        <div class="overview-section">
          <p class="section-label">Locations</p>
          <div id="overview-list"></div>
        </div>
      </div><!-- /state-overview -->
    </aside>
  </div>

  <!-- Loading overlay -->
  <div id="loading-overlay" class="loading-overlay">
    <div class="loading-card glass">
      <div class="spinner"></div>
      <p>Loading map…</p>
    </div>
  </div>
</Layout>

<!-- ═══════════════════════════ SCRIPT ═══════════════════════════ -->
<script>
  import L from "leaflet";
  import "leaflet.markercluster";

  /* ── Types & data ──────────────────────────────────────── */
  type Loc = { name: string; lat: number; lng: number };
  type TileKey = "dark" | "light" | "streets";

  const raw = sessionStorage.getItem("mapData");
  if (!raw) {
    location.href = "/";
    throw 0;
  }
  const data: Loc[] = JSON.parse(raw);
  if (!data.length) {
    location.href = "/";
    throw 0;
  }

  /* ── Helpers ───────────────────────────────────────────── */
  function esc(s: string) {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function haversine(lat1: number, lng1: number, lat2: number, lng2: number) {
    const R = 6371,
      r = Math.PI / 180;
    const a =
      Math.sin(((lat2 - lat1) * r) / 2) ** 2 +
      Math.cos(lat1 * r) *
        Math.cos(lat2 * r) *
        Math.sin(((lng2 - lng1) * r) / 2) ** 2;
    return (R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a))).toFixed(1);
  }

  function fmtKm(km: number): string {
    if (km >= 10000) return (km / 1000).toFixed(1) + "K";
    if (km >= 1000) return Math.round(km).toLocaleString();
    return km.toFixed(1);
  }

  /* ── DOM refs ──────────────────────────────────────────── */
  const locBadge = document.getElementById("loc-badge")!;
  const locNum = document.getElementById("loc-num")!;
  const searchInput = document.getElementById(
    "search-input",
  ) as HTMLInputElement;
  const searchClear = document.getElementById("search-clear")!;
  const dropdown = document.getElementById("search-dropdown")!;
  const resultsEl = document.getElementById("search-results")!;
  const stateWelcome = document.getElementById("state-welcome")!;
  const stateDetail = document.getElementById("state-detail")!;
  const stateOverview = document.getElementById("state-overview")!;
  const btnPrev = document.getElementById("btn-prev")!;
  const btnNext = document.getElementById("btn-next")!;
  const detailPos = document.getElementById("detail-pos")!;
  const panelClose = document.getElementById("panel-close")!;
  const refBadge = document.getElementById("ref-badge")!;
  const panelName = document.getElementById("panel-name")!;
  const panelLat = document.getElementById("panel-lat")!;
  const panelLng = document.getElementById("panel-lng")!;
  const panelDist = document.getElementById("panel-dist")!;
  const distSection = document.getElementById("dist-section")!;
  const mapsLink = document.getElementById(
    "panel-maps-link",
  ) as HTMLAnchorElement;
  const loadingEl = document.getElementById("loading-overlay")!;
  const tabDetail = document.getElementById("tab-detail")!;
  const tabOverview = document.getElementById("tab-overview")!;
  const btnFitAll = document.getElementById("btn-fit-all")!;
  const btnRoute = document.getElementById("btn-route")!;
  const btnHeat = document.getElementById("btn-heat")!;
  const tileBtns = document.querySelectorAll<HTMLElement>(".tile-btn");
  const nearbySection = document.getElementById("nearby-section")!;
  const nearbyList = document.getElementById("nearby-list")!;
  const nearbyLabel = document.getElementById("nearby-label")!;
  const nearbyCountBadge = document.getElementById("nearby-count")!;
  const copyLatBtn = document.getElementById("copy-lat")!;
  const copyLngBtn = document.getElementById("copy-lng")!;
  const statCount = document.getElementById("stat-count")!;
  const statRoute = document.getElementById("stat-route")!;
  const statCoverage = document.getElementById("stat-coverage")!;
  const overviewList = document.getElementById("overview-list")!;

  /* ── Badge ─────────────────────────────────────────────── */
  locNum.textContent = data.length.toString();
  locBadge.classList.remove("hidden");

  /* ── Compute stats ─────────────────────────────────────── */
  const allBounds = L.latLngBounds(
    data.map((d) => [d.lat, d.lng] as [number, number]),
  );

  let totalRouteDist = 0;
  for (let i = 1; i < data.length; i++) {
    totalRouteDist += parseFloat(
      haversine(data[i - 1].lat, data[i - 1].lng, data[i].lat, data[i].lng),
    );
  }

  const lats = data.map((d) => d.lat);
  const lngs = data.map((d) => d.lng);
  const coverageDiag = parseFloat(
    haversine(
      Math.min(...lats),
      Math.min(...lngs),
      Math.max(...lats),
      Math.max(...lngs),
    ),
  );

  statCount.textContent = data.length.toLocaleString();
  statRoute.textContent = fmtKm(totalRouteDist);
  statCoverage.textContent = fmtKm(coverageDiag);

  overviewList.innerHTML = data
    .slice(0, 8)
    .map(
      (loc, i) =>
        `<div class="overview-item" data-i="${i}">
       <div class="res-num">${i + 1}</div>
       <div class="res-name">${esc(loc.name)}</div>
     </div>`,
    )
    .join("");
  overviewList.querySelectorAll<HTMLElement>(".overview-item").forEach((el) => {
    el.addEventListener("click", () => {
      switchTab("detail");
      openDetail(parseInt(el.dataset.i!));
    });
  });

  /* ── Map init ──────────────────────────────────────────── */
  const map = L.map("map", { zoomControl: true });

  /* ── Tile layers ───────────────────────────────────────── */
  const tileLayers: Record<TileKey, L.TileLayer> = {
    dark: L.tileLayer(
      "https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png",
      {
        attribution:
          '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> &copy; <a href="https://carto.com">CARTO</a>',
        maxZoom: 19,
      },
    ),
    light: L.tileLayer(
      "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
      {
        attribution:
          '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> &copy; <a href="https://carto.com">CARTO</a>',
        maxZoom: 19,
      },
    ),
    streets: L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 19,
    }),
  };
  let activeTile: TileKey = "streets";
  tileLayers.streets.addTo(map);

  /* ── Sequential polyline ───────────────────────────────── */
  const polyline = L.polyline(
    data.map((d) => [d.lat, d.lng] as [number, number]),
    {
      color: "#3b82f6",
      weight: 2,
      opacity: 0.65,
    },
  );
  let polylineEnabled = true;
  let polylineOnMap = false;

  function updatePolyline() {
    const shouldShow = polylineEnabled && !heatActive && map.getZoom() >= 11;
    if (shouldShow && !polylineOnMap) {
      polyline.addTo(map);
      polylineOnMap = true;
    }
    if (!shouldShow && polylineOnMap) {
      map.removeLayer(polyline);
      polylineOnMap = false;
    }
  }

  map.on("zoomend", updatePolyline);

  /* ── Canvas heatmap ────────────────────────────────────── */
  let heatActive = false;
  const heatCanvas = document.createElement("canvas");
  heatCanvas.style.cssText =
    "position:absolute;inset:0;z-index:399;pointer-events:none;display:none;";
  document
    .querySelector(".map-wrap")!
    .insertBefore(heatCanvas, document.querySelector(".search-float"));

  function drawHeat() {
    if (!heatActive) return;
    const wrap = document.querySelector(".map-wrap") as HTMLElement;
    heatCanvas.width = wrap.clientWidth;
    heatCanvas.height = wrap.clientHeight;
    const ctx = heatCanvas.getContext("2d")!;
    ctx.clearRect(0, 0, heatCanvas.width, heatCanvas.height);
    const r = Math.max(18, Math.min(55, 4000 / data.length));
    for (const d of data) {
      const p = map.latLngToContainerPoint([d.lat, d.lng]);
      const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, r);
      g.addColorStop(0, "rgba(139,92,246,0.55)");
      g.addColorStop(0.4, "rgba(6,182,212,0.22)");
      g.addColorStop(1, "rgba(0,0,0,0)");
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
      ctx.fill();
    }
  }
  map.on("moveend zoomend", drawHeat);

  /* ── Marker icon factory ───────────────────────────────── */
  type MarkerState = "normal" | "ref" | "active";

  function makeIcon(i: number, state: MarkerState): L.DivIcon {
    const cfg = {
      ref: { fill: "#ef4444", glow: "rgba(239,68,68,0.60)", w: 50, h: 50 },
      active: { fill: "#f59e0b", glow: "rgba(245,158,11,0.65)", w: 50, h: 50 },
      normal: { fill: "#3b82f6", glow: "rgba(59,130,246,0.55)", w: 40, h: 40 },
    }[state];
    const { fill, glow, w, h } = cfg;

    const n = i + 1;
    const fs = n > 99 ? 5 : n > 9 ? 6.5 : 8;

    return L.divIcon({
      className: "",
      html: `<div style="width:${w}px;height:${h}px;filter:drop-shadow(0 4px 10px ${glow});cursor:pointer;">
        <svg width="${w}" height="${h}" viewBox="0 0 24 22" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"
                fill="${fill}" stroke="white" stroke-width="1.3" stroke-linejoin="round"/>
          <text x="12" y="9.5"
                text-anchor="middle" dominant-baseline="central"
                fill="white" font-size="${fs}" font-weight="800"
                font-family="system-ui,-apple-system,sans-serif">${n}</text>
        </svg>
      </div>`,
      iconSize: [w, h],
      iconAnchor: [w / 2, h],
    });
  }

  /* ── Cluster group ─────────────────────────────────────── */
  const clusterRadius = data.length > 500 ? 80 : data.length > 200 ? 65 : 50;

  // @ts-ignore
  const cluster = L.markerClusterGroup({
    maxClusterRadius: clusterRadius,
    spiderfyOnMaxZoom: true,
    showCoverageOnHover: false,
    zoomToBoundsOnClick: true,
    iconCreateFunction: (c: any) => {
      const n = c.getChildCount();
      const s = n > 99 ? 46 : n > 9 ? 40 : 34;
      return L.divIcon({
        html: `<div style="
          width:${s}px;height:${s}px;border-radius:50%;
          background:linear-gradient(135deg,#6366f1,#8b5cf6);
          border:2.5px solid #fff;color:#fff;
          font-size:${n > 99 ? 10 : 12}px;font-weight:700;
          display:flex;align-items:center;justify-content:center;
          box-shadow:0 2px 12px rgba(99,102,241,0.5);
          font-family:system-ui,sans-serif;cursor:pointer;
        ">${n}</div>`,
        className: "",
        iconSize: [s, s],
        iconAnchor: [s / 2, s / 2],
      });
    },
  });

  /* ── Build markers ─────────────────────────────────────── */
  const markers: L.Marker[] = data.map((loc, i) => {
    const m = L.marker([loc.lat, loc.lng], {
      icon: makeIcon(i, i === 0 ? "ref" : "normal"),
    });
    m.on("click", () => openDetail(i));
    if (i === 0) m.addTo(map);
    else cluster.addLayer(m);
    return m;
  });
  map.addLayer(cluster);

  /* ── Fit bounds ────────────────────────────────────────── */
  map.fitBounds(allBounds, { padding: [40, 40] });
  // Delay initial polyline check so zoom is settled
  setTimeout(updatePolyline, 200);

  /* ── Nearest neighbours ────────────────────────────────── */
  function getNearby(idx: number): { i: number; d: string }[] {
    return data
      .map((_, i) => ({
        i,
        d:
          i === idx
            ? Number.MAX_VALUE
            : parseFloat(
                haversine(
                  data[idx].lat,
                  data[idx].lng,
                  data[i].lat,
                  data[i].lng,
                ),
              ),
      }))
      .filter((x) => x.i !== idx)
      .sort((a, b) => a.d - b.d)
      .slice(0, 10)
      .map((x) => ({ i: x.i, d: x.d.toFixed(1) }));
  }

  /* ── Detail panel ──────────────────────────────────────── */
  let activeIdx = -1;

  function openDetail(index: number) {
    if (activeIdx !== -1 && activeIdx !== index) {
      markers[activeIdx].setIcon(
        makeIcon(activeIdx, activeIdx === 0 ? "ref" : "normal"),
      );
    }
    activeIdx = index;
    markers[index].setIcon(makeIcon(index, index === 0 ? "ref" : "active"));

    const loc = data[index];
    const isRef = index === 0;

    panelName.textContent = loc.name;
    panelLat.textContent = loc.lat.toFixed(6);
    panelLng.textContent = loc.lng.toFixed(6);
    detailPos.textContent = `${index + 1} / ${data.length}`;
    mapsLink.href = `https://www.google.com/maps?q=${loc.lat},${loc.lng}`;
    refBadge.classList.toggle("hidden", !isRef);
    distSection.classList.toggle("hidden", isRef);
    if (!isRef)
      panelDist.textContent = haversine(
        data[0].lat,
        data[0].lng,
        loc.lat,
        loc.lng,
      );

    // Nearby
    const nearby = getNearby(index);
    if (nearby.length > 0 && data.length > 1) {
      nearbyLabel.textContent = "Nearby";
      nearbyCountBadge.textContent = nearby.length.toString();
      nearbyList.innerHTML = nearby
        .map(
          ({ i, d }, rank) => `
      <div class="nearby-card" data-i="${i}">
        <div class="nearby-rank">
          ${rank + 1}
        </div>

        <div class="nearby-info">
          <div class="nearby-name">
            ${esc(data[i].name)}
          </div>

          <div class="nearby-id">
            #${i + 1}
          </div>
        </div>

        <div class="nearby-dist-pill">
          ${d} km
        </div>
      </div>
    `,
        )
        .join("");
      nearbyList.querySelectorAll<HTMLElement>(".nearby-card").forEach((el) => {
        el.addEventListener("click", () => openDetail(parseInt(el.dataset.i!)));
      });
      nearbyList.scrollTo({ top: 0, behavior: "smooth" });
      nearbySection.classList.remove("hidden");
    } else {
      nearbySection.classList.add("hidden");
    }

    stateWelcome.classList.add("hidden");
    stateOverview.classList.add("hidden");

    // Slide-in animation
    stateDetail.classList.remove("hidden");
    stateDetail.classList.remove("detail-enter");
    void (stateDetail as HTMLElement).offsetWidth;
    stateDetail.classList.add("detail-enter");

    document.querySelector(".sidebar")?.classList.add("mobile-open");

    // Expand cluster if this marker is hidden inside one, then center on it
    if (heatActive || index === 0) {
      map.flyTo([loc.lat, loc.lng], Math.max(map.getZoom(), 14), {
        duration: 0.6,
        easeLinearity: 0.5,
      });
    } else {
      // @ts-ignore — zoomToShowLayer expands the cluster, then callback fires
      cluster.zoomToShowLayer(markers[index], () => {
        map.flyTo([loc.lat, loc.lng], Math.max(map.getZoom(), 14), {
          duration: 0.4,
          easeLinearity: 0.5,
        });
      });
    }
  }

  function closeDetail() {
    if (activeIdx !== -1) {
      markers[activeIdx].setIcon(
        makeIcon(activeIdx, activeIdx === 0 ? "ref" : "normal"),
      );
      activeIdx = -1;
    }
    stateDetail.classList.add("hidden");
    stateWelcome.classList.remove("hidden");
    document.querySelector(".sidebar")?.classList.remove("mobile-open");
  }

  btnPrev.addEventListener("click", () =>
    openDetail((activeIdx - 1 + data.length) % data.length),
  );
  btnNext.addEventListener("click", () =>
    openDetail((activeIdx + 1) % data.length),
  );
  panelClose.addEventListener("click", closeDetail);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeDetail();
      closeSearch();
    }
    if (e.key === "ArrowLeft" && activeIdx !== -1) btnPrev.click();
    if (e.key === "ArrowRight" && activeIdx !== -1) btnNext.click();
  });

  /* ── Tabs ──────────────────────────────────────────────── */
  function switchTab(tab: "detail" | "overview") {
    tabDetail.classList.toggle("active", tab === "detail");
    tabOverview.classList.toggle("active", tab === "overview");

    if (tab === "overview") {
      stateWelcome.classList.add("hidden");
      stateDetail.classList.add("hidden");
      stateOverview.classList.remove("hidden");
    } else {
      stateOverview.classList.add("hidden");
      if (activeIdx !== -1) {
        stateDetail.classList.remove("hidden");
        stateWelcome.classList.add("hidden");
      } else {
        stateWelcome.classList.remove("hidden");
        stateDetail.classList.add("hidden");
      }
    }
  }

  tabDetail.addEventListener("click", () => switchTab("detail"));
  tabOverview.addEventListener("click", () => switchTab("overview"));

  /* ── Map controls ──────────────────────────────────────── */
  btnFitAll.addEventListener("click", () => {
    map.fitBounds(allBounds, { padding: [40, 40] });
  });

  btnRoute.addEventListener("click", () => {
    polylineEnabled = !polylineEnabled;
    btnRoute.classList.toggle("active", polylineEnabled);
    updatePolyline();
  });

  btnHeat.addEventListener("click", () => {
    heatActive = !heatActive;
    btnHeat.classList.toggle("active", heatActive);

    if (heatActive) {
      heatCanvas.style.display = "";
      drawHeat();
      map.removeLayer(cluster);
      if (markers[0]) map.removeLayer(markers[0]);
      if (polylineOnMap) {
        map.removeLayer(polyline);
        polylineOnMap = false;
      }
    } else {
      heatCanvas.style.display = "none";
      map.addLayer(cluster);
      if (markers[0]) markers[0].addTo(map);
      updatePolyline();
    }
  });

  tileBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const key = btn.dataset.tile as TileKey;
      if (key === activeTile) return;
      tileLayers[activeTile].remove();
      tileLayers[key].addTo(map);
      activeTile = key;
      tileBtns.forEach((b) => b.classList.toggle("active", b === btn));
    });
  });

  /* ── Copy coordinates ──────────────────────────────────── */
  function setupCopy(btn: HTMLElement, getVal: () => string) {
    btn.addEventListener("click", () => {
      navigator.clipboard.writeText(getVal()).then(() => {
        const icon = btn.querySelector(".copy-icon")!;
        const check = btn.querySelector(".copy-check")!;
        icon.classList.add("hidden");
        check.classList.remove("hidden");
        setTimeout(() => {
          icon.classList.remove("hidden");
          check.classList.add("hidden");
        }, 1500);
      });
    });
  }
  setupCopy(copyLatBtn, () => panelLat.textContent ?? "");
  setupCopy(copyLngBtn, () => panelLng.textContent ?? "");

  /* ── Search ────────────────────────────────────────────── */
  function closeSearch() {
    searchInput.value = "";
    dropdown.classList.add("hidden");
    searchClear.classList.add("hidden");
  }

  function renderResults(hits: { loc: Loc; i: number }[]) {
    if (!hits.length) {
      resultsEl.innerHTML = '<p class="no-results">No results found</p>';
    } else {
      resultsEl.innerHTML = hits
        .map(
          ({ loc, i }) =>
            `<div class="res-item" data-i="${i}">
           <div class="res-num">${i + 1}</div>
           <div class="res-name">${esc(loc.name)}</div>
         </div>`,
        )
        .join("");
      resultsEl.querySelectorAll<HTMLElement>(".res-item").forEach((el) => {
        el.addEventListener("click", () => {
          openDetail(parseInt(el.dataset.i!));
          closeSearch();
        });
      });
    }
    dropdown.classList.remove("hidden");
  }

  searchInput.addEventListener("input", () => {
    const q = searchInput.value.trim().toLowerCase();
    if (!q) {
      closeSearch();
      return;
    }
    searchClear.classList.remove("hidden");
    const hits = data
      .map((loc, i) => ({ loc, i }))
      .filter(({ loc }) => loc.name.toLowerCase().includes(q))
      .slice(0, 40);
    renderResults(hits);
  });

  searchClear.addEventListener("click", closeSearch);
  searchInput.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeSearch();
  });
  document.addEventListener("click", (e) => {
    if (!(e.target as Element).closest(".nav-search-wrap")) closeSearch();
  });

  /* ── Hide loading ──────────────────────────────────────── */
  loadingEl.style.transition = "opacity 0.4s";
  loadingEl.style.opacity = "0";
  setTimeout(() => loadingEl.remove(), 450);
</script>

